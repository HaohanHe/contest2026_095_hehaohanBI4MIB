  "name": "AI Radio Console",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1,
  "icon": "/common/logo.png",
  "features": [
    { "name": "system.prompt" },
    { "name": "system.fetch" },
    { "name": "system.vibrator" },
    { "name": "system.device" },
    { "name": "system.storage" },
    { "name": "system.router" },
    { "name": "system.bright" },
    { "name": "system.wifi" },
    { "name": "system.file" },
    { "name": "system.sensor" },
