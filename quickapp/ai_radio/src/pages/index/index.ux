<template>
  <div class="page">
    <!-- 顶部状态栏 24px -->
    <div class="topbar">
      <text class="time">{{ currentTime }}</text>
      <text class="freq">{{ frequency }}</text>
      <text class="mode">{{ mode }}</text>
    </div>
    
    <!-- 频谱显示 60px -->
    <div class="spectrum">
      <div class="bars">
        <div class="bar" for="{{bars}}" style="height:{{$item.h}}px;background-color:{{$item.c}}"></div>
      </div>
    </div>
    
    <!-- CW解码 + 控制卡片 横向排列 100px -->
    <div class="mid">
      <!-- CW区 45%宽 -->
      <div class="cw">
        <text class="cw-label">CW {{cwHz}}Hz</text>
        <div class="dot" style="background-color:{{cwOn?'#ff3344':'#666'}}"></div>
        <text class="cw-text">{{cwText}}</text>
      </div>
      <!-- 卡片区 55%宽 -->
      <div class="cards">
        <div class="card {{sel===i?'sel':''}}" for="{{cards}}" onclick="tap(i)">
          <text class="ct" style="color:{{$item.tc}}">{{$item.t}}</text>
          <text class="cv" style="color:{{$item.vc}}">{{$item.v}}</text>
        </div>
      </div>
    </div>
    
    <!-- 底部 20px -->
    <div class="bottom">
      <text class="hint">VOL: Tune MENU: Mode ENTER: PTT</text>
    </div>
    
    <!-- AI浮层 -->
    <div class="ai" if="{{showAI}}">
      <text class="ai-title">AI Analysis</text>
      <text class="ai-body">{{aiText}}</text>
      <text class="ai-wait" if="{{aiWait}}">Thinking...</text>
    </div>
  </div>
</template>

<style>
.page { flex-direction:column; width:320px; height:240px; background-color:#0a0e1a }
.topbar { flex-direction:row; justify-content:space-between; align-items:center; height:24px; padding:0 6px; background-color:#0d1220 }
.time { color:#e0e8f0; font-size:11px }
.freq { color:#00d4ff; font-size:13px; font-weight:bold }
.mode { color:#00d4ff; font-size:11px }
.spectrum { height:60px; background-color:#060912; padding:2px 4px }
.bars { flex-direction:row; justify-content:space-between; align-items:flex-end; height:52px }
.bar { width:4px; background-color:#103060 }
.mid { flex-direction:row; height:126px; padding:2px }
.cw { flex:45; flex-direction:column; background-color:#0d1220; border-radius:4px; padding:4px; margin-right:2px }
.cw-label { color:#33dd66; font-size:10px }
.dot { width:5px; height:5px; border-radius:3px; margin-top:2px }
.cw-text { color:#e0e8f0; font-size:9px; margin-top:2px; flex:1 }
.cards { flex:55; flex-direction:row; flex-wrap:wrap; margin-left:2px }
.card { width:74px; height:40px; background-color:#141c30; border:1px solid #253048; border-radius:3px; padding:1px; margin:1px; flex-direction:column }
.sel { border-color:#00d4ff; border-width:2px }
.ct { font-size:8px }
.cv { font-size:10px; margin-top:1px }
.bottom { height:20px; background-color:#0d1220; justify-content:center; align-items:center }
.hint { color:#8899aa; font-size:8px }
.ai { position:fixed; top:0; left:0; width:320px; height:240px; background-color:#141c30; border:2px solid #00d4ff; padding:8px; flex-direction:column }
.ai-title { color:#00d4ff; font-size:14px; font-weight:bold }
.ai-body { color:#e0e8f0; font-size:11px; margin-top:6px; flex:1 }
.ai-wait { color:#ffaa00; font-size:11px; margin-top:4px }
</style>

<script>
import velaclaw from '@app-module/system.velaclaw'

export default {
  private: {
    currentTime: '00:00:00',
    frequency: '14.250.000',
    mode: 'USB',
    bars: [],
    cwHz: 700,
    cwOn: false,
    cwText: '...',
    cards: [
      { t:'SIG', v:'S0', tc:'#33dd66', vc:'#e0e8f0' },
      { t:'MAYDAY', v:'OK', tc:'#ff3344', vc:'#33dd66' },
      { t:'AFC', v:'LOCK', tc:'#00ffff', vc:'#00ffff' },
      { t:'FILTER', v:'2.4k', tc:'#ffaa00', vc:'#ffaa00' },
      { t:'PTT', v:'RX', tc:'#00d4ff', vc:'#33dd66' },
      { t:'AI', v:'ASK', tc:'#dd55ff', vc:'#dd55ff' }
    ],
    showAI: false,
    aiText: '',
    aiWait: false,
    sel: 0,
    freqHz: 14250000,
    modeIdx: 0,
    modes: ['USB','LSB','CW','AM','FM']
  },
  
  onInit() {
    for (let i = 0; i < 60; i++) this.bars.push({ h:2, c:'#103060' })
    this.tick()
    setInterval(() => this.tick(), 1000)
  },
  
  tick() {
    this.currentTime = new Date().toTimeString().split(' ')[0]
  },
  
  tap(i) {
    this.sel = i
    if (i === 4) this.togglePTT()
    else if (i === 5) this.askAI('分析当前频率 ' + this.frequency + ' MHz 的通联状态')
  },
  
  togglePTT() {
    const c = this.cards[4]
    if (c.v === 'RX') { c.v = 'TX'; c.vc = '#ff3344' }
    else { c.v = 'RX'; c.vc = '#33dd66' }
  },
  
  askAI(q) {
    this.showAI = true
    this.aiWait = true
    this.aiText = 'Connecting...'
    velaclaw.ask({
      query: q,
      success: (res) => { this.aiText = res.reply; this.aiWait = false },
      fail: (d, code) => { this.aiText = 'Error: ' + code; this.aiWait = false },
      complete: () => { this.aiWait = false }
    })
  }
}
</script>
