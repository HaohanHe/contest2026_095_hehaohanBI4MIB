config LVX_USE_DEMO_DAYNOTE
	bool "DayNote - AI Voice Note Assistant"
	default n
	depends on GRAPHICS_LVGL
	depends on LV_USE_NUTTX
	depends on EXAMPLES_AI_AGENT_VELA || VELACLAW_DAEMON
	select NETUTILS_CJSON
	---help---
		AI-powered voice note assistant with automatic recording,
		ASR transcription, LLM summarization, and timeline review.
		Requires VelaClaw framework for LLM and tools.

if LVX_USE_DEMO_DAYNOTE

config DAYNOTE_DATA_DIR
	string "DayNote data directory"
	default "/data/daynote"

config DAYNOTE_REVIEW_INTERVAL
	int "Default periodic review interval (seconds)"
	default 14400

endif
