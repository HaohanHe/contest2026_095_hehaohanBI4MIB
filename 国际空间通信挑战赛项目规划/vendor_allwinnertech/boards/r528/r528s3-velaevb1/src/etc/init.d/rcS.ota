#include <nuttx/config.h>
#ifdef CONFIG_X4B_OTA

echo "You're running an ota image."
set -x

kvdbd &

setlogmask i

mount -t yaffs /dev/usrdata /data
set errcode $?
if [ $errcode -ne 0 ]
then
    echo "/dev/usrdata mount failed, errcode is" $errcode
    reboot
fi

if [ ! -e /data/ota.zip ]
then
    echo "ota.zip doesn't exist, will reboot to the old system"
    reboot
fi

setprop ota.progress.current 0
setprop ota.progress.next 15

set silent_reboot_flag `getprop persist.silent_reboot.flag`
if [ -z $silent_reboot_flag -o $silent_reboot_flag == false ]
then
    mount -t romfs /dev/res /resource
    set errcode $?
    if [ $errcode -ne 0 ]
    then
        echo "/dev/res mount failed, errcode is" $errcode
        reboot
    fi
    otaUI -c /resource/ota/ota_ui_config.json &
fi

echo "mount ota.zip to /ota"
mount -t zipfs -o /data/ota.zip /ota
set errcode $?
if [ $errcode -ne 0 ]
then
    echo "mount ota.zip failed, will reboot to the old system, errcode is" $errcode
    setprop ota.progress.current -3
    rm /data/ota.zip
    reboot
fi

setprop ota.progress.current 15
setprop ota.progress.next 30

mkdir /data/ota_tmp
sh /ota/ota.sh
set ota_progress `getprop ota.progress.current`
if [ $ota_progress == 100 ]
then
    echo "ota success"
else
    echo "ota failed"
fi

rm -r /data/ota_tmp
rm /data/ota.zip

set silent_reboot_flag `getprop persist.silent_reboot.flag`
if [ -z $silent_reboot_flag -o $silent_reboot_flag == false ]
then
    setprop ota.progress.current 101
else
    reboot
fi

#endif
