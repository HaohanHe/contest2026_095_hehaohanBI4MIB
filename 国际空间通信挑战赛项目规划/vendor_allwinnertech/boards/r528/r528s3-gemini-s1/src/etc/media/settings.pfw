domain: MicDomain
	conf: enable
		UsingDevices Includes mic
		FFmpegCommand = pcm0c,unmute,;
	conf: disable
		ALL
		FFmpegCommand = pcm0c,mute,;

domain: MusicVolumeDomain
	conf: mute
		ANY
			MuteMode   Is on
			MusicVolume In 0
		FFmpegCommand = Music,volume,0;
	conf: index-%MusicVolume
		MusicVolume In [1,9]
		FFmpegCommand = Music,volume,10^(-4*(10-%MusicVolume%)/20);
	conf: 10
		MusicVolume In 10
		FFmpegCommand = Music,volume,1;

