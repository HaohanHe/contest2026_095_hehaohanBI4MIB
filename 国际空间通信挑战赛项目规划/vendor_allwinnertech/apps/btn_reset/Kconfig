#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config BTN_RST_MON
	bool "Reset Button Monitor"
	default n
	---help---
	Enable Reset Button Monitor Program

if BTN_RST_MON

config BTN_RST_MON_TIME_MS
	int "Reset Button Monitoring Time(microsecond)"
	default 10000
	range 3000 10000
	---help---
		If pressing BTN_RST exceeds BTN_RST_MON_TIMEOUT, reset the system

config BTN_RST_MON_PRIORITY
	int "task priority"
	default 100

config BTN_RST_MON_STACKSIZE
	int "stack size"
	default 8192

endif
