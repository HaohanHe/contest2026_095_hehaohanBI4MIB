config LUNCHER_MINI_APP
	bool "luncher mini app"
	default n

	---help---
		Enable luncher mini app.


if LUNCHER_MINI_APP

config LUNCHER_MINI_APP_PROGNAME
	string "Program name"
	default "luncher_mini"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config LUNCHER_MINI_APP_PRIORITY
	int "luncher_mini task priority"
	default 100

config LUNCHER_MINI_APP_STACKSIZE
	int "luncher_mini stack size"
	default 102400

endif

 