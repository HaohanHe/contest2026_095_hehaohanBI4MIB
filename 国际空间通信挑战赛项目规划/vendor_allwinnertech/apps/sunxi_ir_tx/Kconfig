#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_IR_TX_TEST
	bool "IR TX test example"
	default n
	---help---
		Enable the IR TX test example

if EXAMPLES_IR_TX_TEST

config EXAMPLES_IR_TX_TEST_PROGNAME
	string "Program name"
	default "ir_tx_test"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_IR_TX_TEST_PRIORITY
	int "IR_TX_TEST task priority"
	default 100

config EXAMPLES_IR_TX_TEST_STACKSIZE
	int "IR_TX_TEST stack size"
	default DEFAULT_TASK_STACKSIZE

endif
