include ${TOPDIR}/.config
include ${TOPDIR}/tools/Config.mk
include ${TOPDIR}/../vendor/allwinnertech/lichee/tools/scripts/Config.mk
include ${TOPDIR}$(DELIM)arch$(DELIM)arm$(DELIM)src$(DELIM)armv7-a$(DELIM)Toolchain.defs

LDSCRIPT = sdram.ld.S
ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)$(LDSCRIPT)

ARCHPICFLAGS = -fpic -msingle-pic-base -mpic-register=r10

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)$(DELIM)binfmt$(DELIM)libnxflat$(DELIM)gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048

ifeq ($(CONFIG_SERVICES_PNS),y)
  PRODUCT_NAME := ${shell echo $(CONFIG_PNS_PRODUCT_SERIES) |sed -e "s/\"//g"}
  PNS_BASE_DIR = $(TOPDIR)/../vendor/xiaomi/miai/pns/thirdparty/$(PRODUCT_NAME)
  # LIBVPM
  ifeq ($(CONFIG_PNS_LIBVPM_ENABLE),y)
    ifneq ($(wildcard $(PNS_BASE_DIR)/vpm/libs/xiaomi),)
      EXTRA_LIBPATHS += -L $(PNS_BASE_DIR)/vpm/libs/xiaomi
      ifeq ($(CONFIG_ARM_THUMB),y)
        ifeq ($(CONFIG_MM_KASAN),y)
          EXTRA_LIBS += -lvpm_thumb_kasan
        else
          EXTRA_LIBS += -lvpm_thumb
        endif # CONFIG_MM_KASAN
      else
        EXTRA_LIBS += -lvpm
      endif # CONFIG_ARM_THUMB
    endif # PNS_BASE_DIR
  endif # CONFIG_PNS_LIBVPM_ENABLE
  # LIBMDSPEECH
  ifeq ($(CONFIG_PNS_LIBMDSPEECH_ENABLE),y)
    ifneq ($(wildcard $(PNS_BASE_DIR)/mdspeech/libs),)
      EXTRA_LIBPATHS += -L $(PNS_BASE_DIR)/mdspeech/libs
      ifeq ($(CONFIG_ARM_THUMB),y)
        ifeq ($(CONFIG_MM_KASAN),y)
          EXTRA_LIBS += -lmdspeech_thumb_kasan
          EXTRA_LIBS += -liotdcm_thumb_kasan
        else
          EXTRA_LIBS += -lmdspeech_thumb
          EXTRA_LIBS += -liotdcm_thumb
        endif # CONFIG_MM_KASAN
      else
        EXTRA_LIBS += -lmdspeech
        EXTRA_LIBS += -liotdcm
      endif # CONFIG_ARM_THUMB
    endif # PNS_BASE_DIR
  endif # CONFIG_PNS_LIBMDSPEECH_ENABLE
endif # CONFIG_SERVICES_PNS

EXTRA_LIBS += $(wildcard $(shell readlink -f $(TOPDIR)/$(CONFIG_ARCH_BOARD_CUSTOM_DIR)/libs/$(CONFIG_ARCH_BOARD_CUSTOM_NAME))/*.a)

ifeq ($(CONFIG_IEEE80211_REALTEK_WIFI_RTL8733BS),y)
ifeq ($(CONFIG_MM_KASAN),y)
EXTRA_LIBPATHS +=-L$(TOPDIR)/../nuttx/drivers/platform/realtek_ieee80211/wlan_lib_kasan/
else ifeq ($(CONFIG_X4B_FACTEST),y)
EXTRA_LIBPATHS +=-L$(TOPDIR)/../nuttx/drivers/platform/realtek_ieee80211/wlan_lib_factory/
else
EXTRA_LIBPATHS +=-L$(TOPDIR)/../nuttx/drivers/platform/realtek_ieee80211/wlan_lib/
endif
EXTRA_LIBS += -lrtl8733bs
endif

ifneq ($(findstring achange,$(CONFIG_LIB_FFMPEG_CONFIGURATION)),)
CFLAGS += -I $(TOPDIR)/../vendor/xiaomi/vela/libs/voice_change/inc
ifeq ($(CONFIG_MM_KASAN),y)
EXTRA_LIBPATHS += -L "$(TOPDIR)/../vendor/xiaomi/vela/libs/voice_change/r528/kasan"
else
EXTRA_LIBPATHS += -L "$(TOPDIR)/../vendor/xiaomi/vela/libs/voice_change/r528"
endif
EXTRA_LIBS  += -lvoice_change
endif