domain: AcapGainDomain
	conf: index-%AcapGain
		AcapGain In [1,10]
		FFmpegCommand = VolAcap,volume,%AcapGain%;

domain: VoiceChangeDomain
	conf: normal
		VoiceChangeMode Is normal
		FFmpegCommand = VoiceChange,mode,0;
	conf: dashu
		VoiceChangeMode Is dashu
		FFmpegCommand = VoiceChange,mode,1;
	conf: xiaochou
		VoiceChangeMode Is xiaochou
		FFmpegCommand = VoiceChange,mode,4;