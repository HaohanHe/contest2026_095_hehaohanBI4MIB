domain: MicDomain
	conf: enable
		UsingDevices Includes mic
		FFmpegCommand = pcm10c,unmute;pcm11c,unmute;pcm12c,unmute;
	conf: disable
		ALL
		FFmpegCommand = pcm10c,mute;pcm11c,mute;pcm12c,mute;

domain: A2dpDomain
	conf: enable
		UsingDevices Includes a2dpsnk
		FFmpegCommand = a2dpsnk,start;
	conf: disable
		ALL
		FFmpegCommand = a2dpsnk,stop;

domain: A2dpsnkVolumeDomain
	conf: 0
		A2dpsnkVolume In 0
		FFmpegCommand = VolA2dpsnk,volume,0;
	conf: 1
		A2dpsnkVolume In 1
		FFmpegCommand = VolA2dpsnk,volume,-60dB;
	conf: 2
		A2dpsnkVolume In 2
		FFmpegCommand = VolA2dpsnk,volume,-45dB;
	conf: 3
		A2dpsnkVolume In 3
		FFmpegCommand = VolA2dpsnk,volume,-38dB;
	conf: 4
		A2dpsnkVolume In 4
		FFmpegCommand = VolA2dpsnk,volume,-33dB;
	conf: 5
		A2dpsnkVolume In 5
		FFmpegCommand = VolA2dpsnk,volume,-29dB;
	conf: index-%A2dpsnkVolume
		A2dpsnkVolume In [6,14]
		FFmpegCommand = VolA2dpsnk,volume,10^((2*%A2dpsnkVolume%-38)/20);
	conf: 16
		A2dpsnkVolume In 16
		FFmpegCommand = VolA2dpsnk,volume,-7dB;
	conf: 17
		A2dpsnkVolume In 17
		FFmpegCommand = VolA2dpsnk,volume,-6dB;
	conf: 18
		A2dpsnkVolume In 18
		FFmpegCommand = VolA2dpsnk,volume,-5dB;
	conf: 19
		A2dpsnkVolume In 19
		FFmpegCommand = VolA2dpsnk,volume,-4dB;
	conf: 20
		A2dpsnkVolume In 20
		FFmpegCommand = VolA2dpsnk,volume,-3dB;

