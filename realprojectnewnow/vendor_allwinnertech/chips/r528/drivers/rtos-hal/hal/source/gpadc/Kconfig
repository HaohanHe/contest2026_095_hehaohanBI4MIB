menu "GPADC Devices"

config DRIVERS_GPADC
	bool "enable gpadc driver"
	default n

config DRIVERS_GPADC_CTL_NUM
	int "DRIVERS_GPADC_CTL_NUM"
	depends on DRIVERS_GPADC
	default 0
	range 0 2
	---help---
		Select the GPADC controller to use
		On the R528, there is currently only one GPADC controller
		There are two sets of channels inside a control


config HAL_TEST_GPADC
	bool "enable gpadc hal APIs test command"
	depends on DRIVERS_GPADC
		default n

endmenu
