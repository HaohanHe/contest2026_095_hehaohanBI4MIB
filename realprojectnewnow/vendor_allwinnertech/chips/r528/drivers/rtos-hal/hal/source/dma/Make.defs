ifeq ($(CONFIG_DRIVERS_DMA),y)
# Include platform's table.
# Include build support

DRV_SOURCE_PATH=drivers/rtos-hal/hal/source
DMA_PATH=drivers/rtos-hal/hal/source/dma

DEPPATH+=--dep-path $(DMA_PATH)
VPATH+=:chip/$(DMA_PATH)

ARCH_DMA_SRC_PATH:=$(ARCH_SRC)/$(CONFIG_ARCH_CHIP)/$(DMA_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_DMA_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_DMA_SRC_PATH)/platform

# Include the  module.
CHIP_CSRCS += $(DMA_PATH)/hal_dma.c

endif

