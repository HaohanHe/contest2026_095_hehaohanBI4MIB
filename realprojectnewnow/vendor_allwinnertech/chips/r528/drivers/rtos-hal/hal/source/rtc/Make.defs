ifeq ($(CONFIG_DRIVERS_RTC),y)
# Include platform's table.
# Include build support

DRV_SOURCE_PATH=drivers/rtos-hal/hal/source
RTC_PATH=drivers/rtos-hal/hal/source/rtc

DEPPATH+=--dep-path $(RTC_PATH)
VPATH+=:chip/$(RTC_PATH)

ARCH_SRC := $(TOPDIR)/arch/$(CONFIG_ARCH)/src
ARCH_INC := $(TOPDIR)/arch/$(CONFIG_ARCH)/include
ARCH_RTC_SRC_PATH:=$(ARCH_SRC)/$(CONFIG_ARCH_CHIP)/$(RTC_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_RTC_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_RTC_SRC_PATH)/platform

# Include the  module.
CHIP_CSRCS += $(RTC_PATH)/hal_rtc.c
CHIP_CSRCS += $(RTC_PATH)/rtc-lib.c

endif

