ifneq ($(CONFIG_COMPONENTS_BLUETOOTH),)
# Compile kernel
ifneq ($(AW_SRCDIR),)

BLUETOOTH_SOURCE_PATH=components/bluetooth

DEPPATH+=--dep-path $(BLUETOOTH_SOURCE_PATH)
VPATH+=:chip/$(BLUETOOTH_SOURCE_PATH)

ARCH_BLUETOOTH_PATH:=$(AW_SRCDIR)/$(BLUETOOTH_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_BLUETOOTH_PATH)/include

CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)/drivers/rtos-hal/include/osal
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)/components/secure_storage

ifeq ($(CONFIG_X4B_FACTEST),y)
CFLAGS += -DPATCH_BIN_NAME=\"/etc/bt_factest/8723fs_fw_C-cut.bin\" -DCONFIG_BIN_NAME=\"/etc/bt_factest/8723fs_config_C-cut.bin\"
endif

CHIP_CSRCS += $(BLUETOOTH_SOURCE_PATH)/rtk_hci.c
CHIP_CSRCS += $(BLUETOOTH_SOURCE_PATH)/rtk_hci_board.c
CHIP_CSRCS += $(BLUETOOTH_SOURCE_PATH)/rtk_coex.c

endif
endif

