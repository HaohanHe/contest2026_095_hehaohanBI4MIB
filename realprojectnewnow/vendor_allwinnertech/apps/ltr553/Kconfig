#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_LTR553
	bool "LTR553 light and proximity sensor uORB test example"
	default n
	depends on SENSORS_LTR553 && UORB
	---help---
		Enable the LTR553 light and proximity sensor uORB test example.
		This example demonstrates how to use uORB subscription to read
		sensor data from LTR553 light and proximity sensors.

if EXAMPLES_LTR553

config EXAMPLES_LTR553_PROGNAME
	string "Program name"
	default "ltr553_uorb"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_LTR553_PRIORITY
	int "LTR553 test task priority"
	default 100
	---help---
		Priority of the LTR553 test task.

config EXAMPLES_LTR553_STACKSIZE
	int "LTR553 test stack size"
	default DEFAULT_TASK_STACKSIZE
	---help---
		Stack size needed by the LTR553 test task.

endif
