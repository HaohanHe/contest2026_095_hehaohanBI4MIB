config BT_INSTANCE
    bool "BT instance common framework"
    default y

if BT_INSTANCE

config BT_LIGHTCTRL
    bool "BT light control"
    default n

config BT_START
	bool "Bluetooth Instance Test (start bt)"
	default n
	help
	  Enable the Bluetooth instance module used for start bt

if BT_START

config BT_START_PRIORITY
	int "Task priority"
	default 100

config BT_START_STACKSIZE
	int "Stack size"
	default 4096

config BT_START_MODULE
	string "Program name"
	default "bt_start"

endif

if BT_LIGHTCTRL

config BT_LIGHTCTRL_PRIORITY
	int "Task priority"
	default 100

config BT_LIGHTCTRL_STACKSIZE
	int "Stack size"
	default 4096

config BT_LIGHTCTRL_MODULE
	string "Program name"
	default "bt_lightCtrl"

endif

endif # BT_INSTANCE

