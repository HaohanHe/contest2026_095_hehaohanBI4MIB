<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_095_hehaohanBI4MIB" name="contest2026_095_hehaohanBI4MIB">
    <!-- AI 智能电台主控台 DayNote（NuttX 应用） -->
    <linkfile src="app/ai_radio_console" dest="packages/demos/contest2026_095_ai_radio_console"/>
    <!-- 配套快应用（手表/快应用端） -->
    <linkfile src="quickapp/ai_radio" dest="packages/apps/contest2026_095_ai_radio"/>
    <!-- Gemini-S1 板级配置（含 NSH defconfig 改动） -->
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_095_board"/>
  </project>
</manifest>
